    {
      "name": "Roles (GraphQL)",
      "item": [
        {
          "name": "Query: listar roles",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { roles { idRol nombre descripcion estado fechaCreacion } }\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Query: obtener rol por ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($id: Int!) { rol(id: $id) { idRol nombre descripcion estado fechaCreacion } }\",\n  \"variables\": { \"id\": {{rolId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Mutation: crear rol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($nombre: String!, $descripcion: String, $estado: String) { crearRol(nombre: $nombre, descripcion: $descripcion, estado: $estado) { idRol nombre descripcion estado fechaCreacion } }\",\n  \"variables\": {\n    \"nombre\": \"AUDITOR\",\n    \"descripcion\": \"Revisa operaciones del sistema\",\n    \"estado\": \"ACTIVO\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Mutation: actualizar rol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id: Int!, $nombre: String!, $descripcion: String, $estado: String!) { actualizarRol(id: $id, nombre: $nombre, descripcion: $descripcion, estado: $estado) { idRol nombre descripcion estado fechaCreacion } }\",\n  \"variables\": {\n    \"id\": {{rolId}},\n    \"nombre\": \"AUDITOR\",\n    \"descripcion\": \"Revisa operaciones y reportes\",\n    \"estado\": \"INACTIVO\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Mutation: eliminar rol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id: Int!) { eliminarRol(id: $id) }\",\n  \"variables\": { \"id\": {{rolId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        }
      ]
    },
