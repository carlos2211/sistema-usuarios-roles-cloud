            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($idUsuario: Int!, $idRol: Int!) { asignarRolAUsuario(idUsuario: $idUsuario, idRol: $idRol) { idUsuario idRol fechaAsignacion } }\",\n  \"variables\": { \"idUsuario\": {{usuarioId}}, \"idRol\": {{rolId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/asignaciones",
              "host": ["{{baseUrl}}"],
