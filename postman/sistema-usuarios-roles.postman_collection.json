    {
      "name": "Asignaciones (GraphQL)",
      "item": [
        {
          "name": "Query: roles de un usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($idUsuario: Int!) { rolesDeUsuario(idUsuario: $idUsuario) { idRol nombre estado } }\",\n  \"variables\": { \"idUsuario\": {{usuarioId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/asignaciones",
              "host": ["{{baseUrl}}"],
              "path": ["asignaciones"]
            }
          }
        },
        {
          "name": "Query: permisos de un rol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($idRol: Int!) { permisosDeRol(idRol: $idRol) { idPermiso nombre estado } }\",\n  \"variables\": { \"idRol\": {{rolId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/asignaciones",
              "host": ["{{baseUrl}}"],
              "path": ["asignaciones"]
            }
          }
        },
